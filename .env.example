# Environment Variables for Smart Recruitment Platform

# Backend Configuration
JWT_SECRET=SuperSecretKeyForJwtTokenGeneration2026WithAtLeast256BitsLength!
DB_CONNECTION_STRING=Server=localhost,1433;Database=RecruitDB;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;
AI_SERVICE_URL=http://localhost:8000
ASPNETCORE_ENVIRONMENT=Development

# AI Microservice Configuration
OPENAI_API_KEY=sk-proj-sample-api-key-replace-with-actual
LLM_MODEL=gpt-4
MAX_PARSING_TOKENS=2000
ENVIRONMENT=development

# Frontend Configuration
API_BASE_URL=http://localhost:5000/api

# Kubernetes Cluster Config (IaC)
K8S_CLUSTER_NAME=recruitment-aks-cluster
RESOURCE_GROUP=rg-recruitment-dev
LOCATION=eastus
